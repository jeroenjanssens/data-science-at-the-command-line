#!/usr/bin/env python3
"""curl, but cached URLs are served from /data/.cache/http.

The book shows the real curl command; this wrapper (first on PATH, so it
also works in `parallel` and `sh -c`) rewrites URLs that are in the cache to
the local cache server (cache-server.py), so curl behaves as usual: progress
meter, -s, -I, -O, -o, -L, ... Other URLs go to the network.
Add entries with bin/cache-url.py.
"""
import os
import sys
import urllib.parse

sys.path.insert(0, "/book")
from cache_path import cache_path  # noqa: E402

CACHE = "/data/.cache/http"
SERVER = "http://127.0.0.1:8642/"

args = []
for arg in sys.argv[1:]:
    rel = cache_path(arg)
    if rel and os.path.isfile(os.path.join(CACHE, rel)):
        arg = SERVER + urllib.parse.quote(rel)
    args.append(arg)
os.execv("/usr/bin/curl", ["curl"] + args)
